generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enum support in Prisma; roles/formats are plain
// strings constrained by the application (see server/src/types.ts).
model User {
  id           String            @id @default(cuid())
  email        String            @unique
  name         String
  passwordHash String
  role         String            @default("USER")
  createdAt    DateTime          @default(now())
  sessions     Session[]
  progress     ReadingProgress[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// A detected multi-volume work (e.g. a folder of numbered books, or files
// sharing a common "Title 01", "Title 02" filename prefix) — the book
// equivalent of a TV show grouping its episodes.
model Series {
  id        String   @id @default(cuid())
  title     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  books     Book[]
}

model Book {
  id           String            @id @default(cuid())
  path         String            @unique
  format       String
  title        String
  author       String?
  description  String?
  isbn         String?
  publishedAt  String?
  hasCover     Boolean           @default(false)
  fileSize     Int
  // TXT only: the text encoding to decode the file with when serving it for
  // reading (see server/src/books/textEncodings.ts for the allowed values).
  // Other formats ignore this — EPUB/PDF carry their own encoding info.
  encoding     String            @default("utf-8")
  addedAt      DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  progress     ReadingProgress[]
  seriesId     String?
  series       Series?           @relation(fields: [seriesId], references: [id])
  volumeNumber Float?
  volumeLabel  String?
  // Set when a series was manually ungrouped, so automatic series detection
  // on a later scan doesn't silently put it right back together.
  seriesOverride Boolean         @default(false)

  @@index([seriesId])
}

model ReadingProgress {
  id        String   @id @default(cuid())
  userId    String
  bookId    String
  location  String
  percent   Float    @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
}
